{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::track-trace-artifacts-525753067477-us-east-2/github-releases/*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "codebuild:StartBuild",
        "codebuild:BatchGetBuilds"
      ],
      "Resource": "arn:aws:codebuild:us-east-2:525753067477:project/track-trace-image-build"
    },
    {
      "Effect": "Allow",
      "Action": [
        "ecr:DescribeImages",
        "ecr:DescribeImageScanFindings"
      ],
      "Resource": "arn:aws:ecr:us-east-2:525753067477:repository/track-trace"
    },
    {
      "Effect": "Allow",
      "Action": [
        "scheduler:GetSchedule",
        "scheduler:UpdateSchedule"
      ],
      "Resource": [
        "arn:aws:scheduler:us-east-2:525753067477:schedule/default/track-trace-maersk-every-6h",
        "arn:aws:scheduler:us-east-2:525753067477:schedule/default/track-trace-wan-hai-every-6h",
        "arn:aws:scheduler:us-east-2:525753067477:schedule/default/track-trace-cma-cgm-every-6h",
        "arn:aws:scheduler:us-east-2:525753067477:schedule/default/track-trace-msc-every-6h",
        "arn:aws:scheduler:us-east-2:525753067477:schedule/default/track-trace-one-every-6h"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeTaskDefinition",
        "ecs:RegisterTaskDefinition"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "ecs:RunTask"
      ],
      "Resource": "arn:aws:ecs:us-east-2:525753067477:task-definition/track-trace-release-pilot:*",
      "Condition": {
        "ArnEquals": {
          "ecs:cluster": "arn:aws:ecs:us-east-2:525753067477:cluster/track-trace-prod"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeTasks",
        "ecs:StopTask"
      ],
      "Resource": "arn:aws:ecs:us-east-2:525753067477:task/track-trace-prod/*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::525753067477:role/TrackTraceTaskRole",
        "arn:aws:iam::525753067477:role/TrackTraceEcsExecutionRole"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::525753067477:role/TrackTraceSchedulerRole",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "scheduler.amazonaws.com"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::525753067477:role/TrackTraceCodeBuildRole",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "codebuild.amazonaws.com"
        }
      }
    }
  ]
}
