# Hapag-Lloyd adapter config
# Browser/page mode (recommended when API auth is not available)
HAPAG_USE_PLAYWRIGHT=true
HAPAG_PLAYWRIGHT_REQUIRED=false
HAPAG_PLAYWRIGHT_HEADLESS=true
HAPAG_PLAYWRIGHT_BROWSER=chromium
HAPAG_PLAYWRIGHT_CHANNEL=
HAPAG_PLAYWRIGHT_LOCALE=en-US
HAPAG_PLAYWRIGHT_CHALLENGE_TIMEOUT_SECONDS=20
HAPAG_PLAYWRIGHT_CHALLENGE_RELOAD_ATTEMPTS=1
HAPAG_PLAYWRIGHT_SESSION_REUSE=true
HAPAG_PLAYWRIGHT_WARMUP_SECONDS=4
HAPAG_PLAYWRIGHT_TIMEOUT_SECONDS=90
HAPAG_PLAYWRIGHT_REQUEST_DELAY_SECONDS=6
HAPAG_PLAYWRIGHT_VIEW=S8510
HAPAG_PLAYWRIGHT_CONTAINER_URL_TEMPLATE=https://www.hapag-lloyd.com/en/online-business/track/track-by-container-solution.html?view={view}&container={reference}
